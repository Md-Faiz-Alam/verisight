# Logging
VERISIGHT_LOG_LEVEL=INFO

# Maximum accepted upload size in megabytes
VERISIGHT_MAX_UPLOAD_SIZE_MB=100

# Gemini API configuration
# Create a key in Google AI Studio and keep the real value in .env only.
VERISIGHT_GEMINI_API_KEY=
VERISIGHT_GEMINI_MODEL=gemini-3.1-flash-lite
# Optional: a different model for the independent second query.
# VERISIGHT_GEMINI_CROSS_CHECK_MODEL=
